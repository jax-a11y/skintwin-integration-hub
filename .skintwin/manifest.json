{
  "$schema": "https://raw.githubusercontent.com/jax-a11y/skintwin-ecosystem-design/main/schemas/ecosystem-manifest.schema.json",
  "manifestVersion": "1.0",
  "github": "jax-a11y/skintwin-integration-hub",
  "layer": "integration",
  "role": "integration-gateway",
  "description": "Flask integration layer connecting the salon platform to Wix Bookings, OpenCart, and Shopify B2B: unified API gateway (/api/integrations/*), canonical Unified* data models, webhook router emitting unified events.",
  "designAlias": "skintwin-integrations (E-commerce & Booking Service)",
  "gatewayPrefix": "/api/integrations/*",
  "provides": [
    "integration-api"
  ],
  "consumes": [],
  "events": {
    "publishes": [
      "order.created",
      "order.paid",
      "product.updated",
      "appointment.created",
      "appointment.updated",
      "inventory.updated"
    ],
    "subscribes": [
      "user.created"
    ]
  },
  "ci": {
    "workflows": [
      "ci-build.yml (ruff/flake8/mypy, pytest, DB checks)"
    ],
    "usesReusable": false
  },
  "registry": "https://github.com/jax-a11y/skintwin-ecosystem-design/blob/main/registry/ecosystem.json"
}
